# Create first matrix
matrix1 = [
    [1, 2],
    [3, 4]
]

# Create second matrix
matrix2 = [
    [5, 6],
    [7, 8]
]

# Create an empty matrix for the result
result = [
    [0, 0],
    [0, 0]
]

# Add the two matrices
for i in range(2):
    for j in range(2):
        result[i][j] = matrix1[i][j] + matrix2[i][j]

# Display the result
print("First Matrix:")
print(matrix1)

print("Second Matrix:")
print(matrix2)

print("Addition of two matrices:")
for row in result:
    print(row)
